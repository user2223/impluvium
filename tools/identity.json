{
  "schema": 1,
  "product": {"name": "impluvium", "publisher": "impluvium", "domain": "impluvium.dev",
              "repository": "https://github.com/user2223/impluvium", "security_contact": "security@impluvium.dev"},
  "programs": {"desktop": "impluvium", "cli": "impluvium-cli", "run": "impluvium-run",
               "server": "impluvium-server", "manifest": "impluvium-manifest"},
  "desktop": {"identifier": "dev.impluvium.client", "product_name": "impluvium", "window_title": "impluvium",
              "linux_package": "impluvium", "desktop_id": "dev.impluvium.client",
              "cargo_package": "impluvium", "cargo_lib": "impluvium_lib"},
  "url_scheme": {"name": "impluvium", "public_contract": "reserved", "registered_by_current_client": true},
  "server_identity": {"app_name": "impluvium"},
  "data_dir": {"name": "impluvium", "debug_name": "impluvium-debug",
               "linux": "XDG base directories, then <name>", "windows": "%LOCALAPPDATA%\\<name>"},
  "keyring": {"service": "impluvium", "debug_service": "impluvium-debug"},
  "env": {"prefix": "IMPLUVIUM_", "register": "tools/env-register.json"},
  "user_agent": {"format": "<token>/<version> (<os>; <arch>)", "third_party_comment": "+<product.repository>",
                 "os": ["linux", "windows"], "arch": ["x86_64", "aarch64"],
                 "tokens": {"desktop": "impluvium-desktop", "cli": "impluvium-cli", "run": "impluvium-run",
                            "server": "impluvium-server", "manifest": "impluvium-manifest"}},
  "packages": {"crate_prefix": "impluvium-", "npm_prefix": "impluvium-", "image": "impluvium-server",
               "npm": {"server": "impluvium-web", "desktop": "impluvium-desktop"}},
  "legacy": {"identifier": "org.droposs.client", "data_dir": "drop", "debug_data_dir": "drop-debug",
             "keyring_service": "drop", "url_scheme": "drop", "user_agent": "Drop Desktop Client",
             "app_name": "Drop", "linux_package": "drop-desktop-client", "desktop_program": "drop-app"},
  "bindings": [
    {"value": "desktop.product_name", "file": "desktop/src-tauri/tauri.conf.json", "json": "/productName"},
    {"value": "desktop.identifier", "file": "desktop/src-tauri/tauri.conf.json", "json": "/identifier"},
    {"value": "product.publisher", "file": "desktop/src-tauri/tauri.conf.json", "json": "/bundle/publisher"},
    {"value": "url_scheme.name", "file": "desktop/src-tauri/tauri.conf.json", "json": "/plugins/deep-link/desktop/schemes/0"},
    {"value": "desktop.cargo_package", "file": "desktop/src-tauri/Cargo.toml", "toml": "package.name"},
    {"value": "desktop.cargo_lib", "file": "desktop/src-tauri/Cargo.toml", "toml": "lib.name"},
    {"value": "product.name", "file": "desktop/src-tauri/Cargo.toml", "regex": "^description = \"The desktop client of (impluvium),"},
    {"value": "desktop.cargo_lib", "file": "desktop/src-tauri/src/main.rs", "regex": "^\\s*(\\w+)::run\\(\\);$"},
    {"value": "desktop.cargo_package", "file": "Cargo.lock", "regex": "^name = \"(impluvium)\"$"},
    {"value": "desktop.cargo_package", "file": "desktop/README.md", "regex": "cargo clippy --locked -p ([\\w-]+)"},
    {"value": "desktop.cargo_package", "file": ".gitea/workflows/ci.yml", "regex": "-p ([\\w-]+) -p client "},
    {"value": "desktop.cargo_package", "file": ".gitea/workflows/ci.yml", "regex": "--package ([\\w-]+) --package client "},
    {"value": "desktop.cargo_package", "file": "tools/ci/clippy-baseline.json", "regex": "^\\s*\"(impluvium)\": 0,$"},
    {"value": "desktop.window_title", "file": "desktop/src-tauri/src/lib.rs", "regex": "WindowBuilder::new\\(&handle, \"main\"\\)\\s*\\.title\\(\"([^\"]+)\"\\)"},
    {"value": "data_dir.name", "file": "desktop/src-tauri/database/src/db.rs", "regex": "static DATA_ROOT_PREFIX: &str = \"(impluvium)\";"},
    {"value": "data_dir.debug_name", "file": "desktop/src-tauri/database/src/db.rs", "regex": "static DATA_ROOT_PREFIX: &str = \"(impluvium-debug)\";"},
    {"value": "keyring.service", "file": "desktop/src-tauri/database/src/db.rs", "regex": "\\} else \\{ \"(impluvium)\" \\}"},
    {"value": "keyring.debug_service", "file": "desktop/src-tauri/database/src/db.rs", "regex": "\\{ \"(impluvium-debug)\" \\} else"},
    {"value": "user_agent.tokens.desktop", "file": "desktop/src-tauri/remote/src/utils.rs", "regex": "const USER_AGENT_TOKEN: &str = \"([^\"]+)\";"},
    {"value": "user_agent.tokens.desktop", "file": "server/composables/request.ts", "regex": "startsWith\\(\"([^\"/]+)/\"\\)"},
    {"value": "server_identity.app_name", "file": "server/server/api/v1/index.get.ts", "regex": "appName: \"([^\"]+)\""},
    {"value": "server_identity.app_name", "file": "desktop/src-tauri/src/remote.rs", "regex": "app_name\\(\\) != \"([^\"]+)\""},
    {"value": "user_agent.tokens.server", "file": "server/server/internal/user-agent.ts", "regex": "export const USER_AGENT_TOKEN = \"([^\"]+)\";"},
    {"value": "product.repository", "file": "server/server/internal/user-agent.ts", "regex": "export const USER_AGENT_REPOSITORY = \"([^\"]+)\";"},
    {"value": "url_scheme.name", "file": "server/server/api/v1/client/auth/callback/index.post.ts", "regex": "redirect: `([a-z]+)://handshake/"},
    {"value": "url_scheme.name", "file": "server/server/internal/clients/README.md", "regex": "`([a-z]+)://handshake/"},
    {"value": "env.prefix", "file": "Dockerfile", "regex": "^ARG (IMPLUVIUM_)VERSION$"},
    {"value": "env.prefix", "file": "Dockerfile", "regex": "^ARG (IMPLUVIUM_)GIT_REF=unknown$"},
    {"value": "env.prefix", "file": "server/nuxt.config.ts", "regex": "process\\.env\\.(IMPLUVIUM_)GIT_REF \\?\\?"},
    {"value": "env.prefix", "file": "server/nuxt.config.ts", "regex": "if \\(process\\.env\\.(IMPLUVIUM_)VERSION\\) \\{"},
    {"value": "env.prefix", "file": "server/nuxt.config.ts", "regex": "return process\\.env\\.(IMPLUVIUM_)VERSION;"},
    {"value": "env.prefix", "file": ".gitea/workflows/ci.yml", "regex": "^\\s+(IMPLUVIUM_)VERSION: \\$\\{\\{ steps\\.version\\.outputs\\.version \\}\\}$"},
    {"value": "env.prefix", "file": ".gitea/workflows/ci.yml", "regex": "build-arg:(IMPLUVIUM_)VERSION="},
    {"value": "env.prefix", "file": ".gitea/workflows/ci.yml", "regex": "build-arg:(IMPLUVIUM_)GIT_REF="},
    {"value": "env.prefix", "file": ".gitea/workflows/ci.yml", "regex": "^\\s+(IMPLUVIUM_)VERSION=\"\\$IMPLUVIUM_VERSION\" GITHUB_SHA="},
    {"value": "product.name", "file": "server/build/launch.sh", "regex": "^echo \"\\[(impluvium)\\] performing migrations\\.\\.\\.\"$"},
    {"value": "product.name", "file": ".gitea/workflows/ci.yml", "regex": "marker='\\[(impluvium)\\] performing migrations'"},
    {"value": "product.name", "file": "server/server/internal/config/application-configuration.ts", "regex": "serverName: \"([^\"]+)\","},
    {"value": "product.repository", "file": "server/components/UserFooter.vue", "regex": "^\\s+to=\"(https://github\\.com/[^\"]+)\"$"},
    {"value": "product.repository", "file": "server/components/UserFooter.vue", "regex": "href: \"([^\"]+)\",\\s+icon: IconsGithubLogo,"},
    {"value": "product.repository", "file": "desktop/main/pages/setup/server.vue", "regex": "href=\"(https://github\\.com/[^\"]+)\"\\s+target=\"_blank\""},
    {"value": "packages.npm.server", "file": "server/package.json", "json": "/name"},
    {"value": "packages.npm.desktop", "file": "desktop/package.json", "json": "/name"}
  ]
}
