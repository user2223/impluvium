{
  "manifest_version": 2,
  "purpose": "Inputs of the chunking/hashing benchmark. Data is never redistributed: the loader downloads from the official sources and checks checksums.",
  "tools": {
    "chunkbench": "0.1.0",
    "generator": "chunkbench-gen/1 (corpus-model/1)",
    "loader": "corpus/fetch_corpora.py",
    "historical_loader_image": {"image": "python:3.13-alpine", "digest": {"algorithm": "sha256", "hex_parts": ["8bcfa47b04b853a17aaf909362b847b2", "112fd6ec4105ea553ef9a43bafbb5916"]}}
  },
  "benchmark_parameters": {
    "candidate_grid": {
      "cdc_fastcdc_v2020": {"avg": ["256 KiB", "1 MiB", "4 MiB"], "min": "avg/4", "max": "min(4*avg, 16 MiB)"},
      "fixed_blocks": ["256 KiB", "1 MiB", "4 MiB", "16 MiB"],
      "baseline_not_selectable": "fixed 64 MiB"
    },
    "chunking_rules": "a file of at most max bytes is one chunk (an empty file has zero chunks, see the report), larger files are split per file, chunks never cross file boundaries, unchanged files (same path and content hash) are reused whole",
    "transfer_formula": "T(pair) = bytes of the distinct chunks of the new version absent from the old version; class value = mean over the pairs of T / size of the new version; T-bar = mean over classes with equal weight; gain of A over B = T-bar(B) - T-bar(A) in percentage points",
    "selection_rule": "(1) drop candidates violating limits (chunks per manifest in the 100 GB model <= 4,000,000, manifest <= 512 MiB); (2) CDC from large to small, a smaller candidate replaces the current one only with >= 5 points gain over the current one; (3) the same for fixed blocks starting at 16 MiB; (4) CDC is chosen only if it beats the fixed result and the fixed block of the same nominal size by >= 5 points; (5) deviations of a class by more than 10 points in the other direction are reported for every decisive comparison",
    "model_100gb": {
      "files": 1000000,
      "bytes": 100000000000,
      "size_distribution": "999000 files from corpus-model SIZE_TABLE plus 1000 large files filling the remainder",
      "chunk_ids": "all distinct (no dedup)",
      "worst_case": "every split CDC chunk has the minimum size"
    },
    "hash": {
      "algorithms": ["sha256 (sha2 0.11.1, runtime SHA-NI detection)", "blake3 (blake3 1.8.7, no rayon)"],
      "workers": [1, 4],
      "readers": 1,
      "paths": ["build: read, chunk, hash", "verify: read with recorded boundaries, hash, compare"],
      "cache": ["warm", "cold (fsync + posix_fadvise DONTNEED, residency checked with mincore)"],
      "default_reps": 5
    },
    "chunk_identity": "BLAKE3-256 in the chunk analysis (independent of the manifest hash decision)",
    "fastcdc": "fastcdc 5.0.0, v2020, FastCDC::new / StreamCDC::new (normalisation level 1)",
    "tool_revision": "recorded in every result file as machine.source_revision (git commit of this repository)"
  },
  "inputs": [
    {
