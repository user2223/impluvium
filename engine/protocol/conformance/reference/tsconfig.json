{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowJs": true,
    "checkJs": false,
    "types": [
      "node"
    ],
    "skipLibCheck": false
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "tooling/**/*.mjs",
    "container/**/*.ts",
    "container/**/*.mjs"
  ]
}
