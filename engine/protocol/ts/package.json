{
  "name": "impluvium-protocol",
  "version": "0.1.0",
  "private": true,
  "license": "0BSD",
  "type": "module",
  "engines": { "node": "^24.0.0" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./generated/*": { "types": "./dist/generated/*.d.ts", "import": "./dist/generated/*.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": { "@bufbuild/protobuf": "2.16.0" },
  "devDependencies": { "@bufbuild/protoc-gen-es": "2.16.0", "typescript": "5.9.3" }
}
