# The build context is an allow-list: everything is excluded, and only the
# build inputs are added back below.
*

# Node workspace: the server and its Nuxt layer.
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!server/
!libraries/base/
!tools/web-spa/

# Rust workspace. Only torrential is built, but Cargo loads every member, so
# the desktop crates are needed with their manifests and sources (and nothing
# else from desktop/). torrential/proto is also an input of the server build.
!Cargo.toml
!Cargo.lock
!torrential/Cargo.toml
!torrential/build.rs
!torrential/benches/
!torrential/proto/
!torrential/src/
!libraries/droplet/
!libraries/droplet_types/
!libraries/libarchive/
!desktop/src-tauri/Cargo.toml
!desktop/src-tauri/*/Cargo.toml
!desktop/src-tauri/src/
!desktop/src-tauri/*/src/
!engine/LICENSE
!engine/protocol/NOTICE
!engine/crates/protocol/Cargo.toml
!engine/crates/protocol/src/
!engine/crates/client/Cargo.toml
!engine/crates/client/src/
!engine/protocol/xtask/Cargo.toml
!engine/protocol/xtask/src/
!engine/protocol/benchmarks/hashchunk/Cargo.toml
!engine/protocol/benchmarks/hashchunk/src/

# Never part of the context, wherever they are.
**/target
**/node_modules
**/.env*
**/.nuxt*
**/.output*
**/.spa-server
**/.data

# Validation sources and corpus never enter the server build context.
engine/protocol/conformance/reference/
engine/protocol/testdata/
